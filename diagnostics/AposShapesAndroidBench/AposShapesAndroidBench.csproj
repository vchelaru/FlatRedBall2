<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AposShapesAndroidBench</RootNamespace>
    <ApplicationId>com.flatredball.aposbench</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- Switch with -p:AposVer=0.8.6. Overrides the central Apos.Shapes version for this project only. -->
    <AposVer Condition="'$(AposVer)' == ''">0.9.1</AposVer>
  </PropertyGroup>

  <ItemGroup>
    <!-- No FlatRedBall2, no Gum: only the KNI Android backend and Apos.Shapes. -->
    <PackageReference Include="nkast.Kni.Platform.Android.GL" />
    <PackageReference Include="Apos.Shapes.KNI" VersionOverride="$(AposVer)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0.9.1's shader with only some techniques kept; see Variants/make-variants.py. -->
    <EmbeddedResource Include="Variants/*.knifx.gz" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
