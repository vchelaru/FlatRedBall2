<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!--
      Generate the XML doc file alongside the .dll so IntelliSense lights up for consumers
      of the eventual NuGet package. CS1591 ("missing XML comment for publicly visible type
      or member") is intentionally left as a warning — visible in build output as a tracked
      metric so the doc-coverage gap is obvious, but not failing the build during preview.
      Promote to error before the first stable (non-preview) NuGet ships.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- NuGet Metadata -->
    <Authors>Victor Chelaru</Authors>
    <Description>A modern, lightweight 2D game engine built on MonoGame (DesktopGL).</Description>
    <PackageId>FlatRedBall2.MonoGame</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vchelaru/FlatRedBall2</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vchelaru/FlatRedBall2</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink and Symbols (for debugging inside the NuGet package) -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <DefineConstants>$(DefineConstants);MONOGAME</DefineConstants>

    <!--
      This is the MonoGame/desktop backend build of the engine. Kni\FlatRedBall2.Kni.csproj is
      the KNI/browser backend — a separate single-TFM project file rather than a second slice of
      this one's TargetFrameworks, because both backends now target net10.0 and a single project
      can't list the same TFM twice to pick different package sets. Splitting into sibling files
      sidesteps that entirely: each file just points at a different set of PackageReferences, no
      property-passing through ProjectReference/NuGet restore needed (that approach was rejected
      historically because AdditionalProperties on ProjectReference doesn't propagate through
      NuGet restore). Kni\FlatRedBall2.Kni.csproj compiles this directory's source explicitly
      (its own EnableDefaultCompileItems is off) rather than sharing this project's own default
      glob — two SDK projects globbing the same physical directory hits a real MSBuild
      parallel-build race (#966), which is why the KNI backend lives in its own subfolder instead
      of right next to this file.

      The sibling project FlatRedBall2.BlazorGL lives at src/FlatRedBall2.BlazorGL/. Without
      this exclude, the SDK's default compile glob (**/*.cs) picks up its files and tries to
      compile them as part of FlatRedBall2 itself, which fails because the engine doesn't
      reference the AspNetCore.Components / JSInterop assemblies. AnimationChain.Common is its own
      MonoGame-free project (see ProjectReference below) for the same reason. Kni\ is excluded
      for the same reason — it holds only Kni.csproj, but keeps globbing from ever reaching in.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);FlatRedBall2.BlazorGL\**;AnimationChain.MonoGame\**;AnimationChain.Common\**;Animation.Content\**;AnimationEditorCommon\**;Kni\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Backend-agnostic packages -->
  <ItemGroup>
    <PackageReference Include="AsepriteDotNet" />
    <PackageReference Include="FlatRedBall.InterpolationCore" />
    <!-- Pure managed OGG decoder for the pitchable streaming music path (StreamingOggMusicBackend). -->
    <PackageReference Include="NVorbis" />
  </ItemGroup>

  <!--
    The .achx data model (AnimationChainListSave, AnimationFrameSave, ShapesSave, ColorOperation,
    etc.) has no MonoGame dependency, so it lives in its own project. This lets tooling like the
    Animation Editor (Avalonia, not MonoGame) reference the .achx format without pulling in
    MonoGame.Framework.DesktopGL at all; see tools/AnimationEditorAvalonia/docs/BROWSER_SPIKE_FINDINGS.md.
  -->
  <ItemGroup>
    <ProjectReference Include="AnimationChain.Common/AnimationChain.Common.csproj" />
  </ItemGroup>

  <!--
    TEMPORARY — local Gum source instead of the NuGet packages, for live-testing in-progress Gum
    fixes (immediate-mode RenderStateChangeStatistics.DrawCallCount). Revert to the three
    PackageReference lines below once done; assumes a sibling ../../Gum checkout.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Gum\MonoGameGum\MonoGameGum.csproj" />
    <ProjectReference Include="..\..\Gum\Runtimes\GumShapes\MonoGameGumShapes.csproj" />
    <ProjectReference Include="..\..\Gum\Integrations\KernSmith\KernSmith.MonoGameGum\KernSmith.MonoGameGum.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Apos.Shapes" />
    <!--
    <PackageReference Include="Gum.MonoGame" />
    <PackageReference Include="Gum.Shapes.MonoGame" />
    <PackageReference Include="KernSmith.MonoGameGum" />
    -->
    <PackageReference Include="MonoGame.Framework.DesktopGL">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MonoGame.Extended" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>FlatRedBall2.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Precompiled ColorOperation.Add pixel shader (see src/Shaders/AddColor.fx for HLSL source).
    Compiled once via ShadowDusk.Compiler (Target=OpenGL, Mgfx v10 container - see the
    `shadowdusk` skill) since this library has no content pipeline of its own; the same bytes
    load on both the MonoGame and KNI backends via `new Effect(graphicsDevice, bytes)`.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Rendering/Shaders/AddColor.mgfx" LogicalName="FlatRedBall2.Rendering.Shaders.AddColor.mgfx" />
  </ItemGroup>
</Project>
