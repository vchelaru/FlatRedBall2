<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows Sandbox tests: slow (minutes per scenario) and need Windows Pro/Enterprise/Education.
       Deliberately absent from AnimationEditorAvalonia.slnx, scripts/test-ae.py, and CI, so they only
       run when someone targets this project explicitly. See the animation-editor-testing skill. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Scenarios\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
