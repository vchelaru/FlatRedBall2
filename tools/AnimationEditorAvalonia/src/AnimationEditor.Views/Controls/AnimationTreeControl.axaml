<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:AnimationEditor.Core.ViewModels"
             x:Class="AnimationEditor.Views.Controls.AnimationTreeControl">
    <TreeView x:Name="Tree"
              SelectionMode="Multiple"
              AutomationProperties.Name="Animations"
              AutomationProperties.AutomationId="animations-tree">
        <TreeView.Styles>
            <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
            </Style>
            <!-- Phase 15: hover-reveal add-frame button on chain rows, matching desktop.
                 #1173: anchored on Grid.tree-row:pointerover, NOT TreeViewItem:pointerover.
                 Avalonia's :pointerover pseudo-class propagates to every visual ancestor under
                 the pointer, so hovering a frame row (nested inside its expanded parent chain's
                 TreeViewItem) also marked the *parent chain's* TreeViewItem :pointerover, which
                 then matched every descendant Button/TextBlock under it, including the chain's
                 own, revealing its buttons and widening its meta text even though the pointer
                 was never over the chain header. Grid.tree-row is the DataTemplate's own root
                 element, i.e. just that row's header content: it does not visually contain any
                 nested child TreeViewItems (those render in the TreeViewItem's own separate
                 ItemsPresenter), so its :pointerover can only ever reflect the pointer being
                 over that specific row. -->
            <Style Selector="Button.add-frame-btn">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>
            <Style Selector="Grid.tree-row:pointerover Button.add-frame-btn">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
                <Setter Property="Focusable" Value="True" />
            </Style>
            <!-- #1032: chain lock icon. Hover-reveal like add-frame-btn when unlocked, but always
                 visible (via the .locked class, bound to TreeNodeVm.IsLocked) so a locked chain is
                 recognizable at a glance without hovering. -->
            <Style Selector="Button.lock-btn">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>
            <Style Selector="Grid.tree-row:pointerover Button.lock-btn">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
                <Setter Property="Focusable" Value="True" />
            </Style>
            <Style Selector="Button.lock-btn.locked">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
                <Setter Property="Focusable" Value="True" />
            </Style>
            <!-- #1035: the meta text's right margin must clear whichever icon lane(s) are
                 actually visible, not always assume one. Locking a chain hides the add-frame
                 button (CanAddFrame) and always shows the lock icon, so only two cases exist: no
                 icon lane visible (tight), or the lock icon's lane visible (locked, or hovered
                 while unlocked, since hover reveals both add-frame and lock together). The lock
                 lane sits further from the edge than add-frame's, so clearing it clears both. The
                 ":not(.locked)" on the hover rule keeps a locked+hovered row on the locked margin
                 rather than depending on style declaration order.
                 The hover rule is also scoped to TextBlock.meta.chain (bound to IsChainNode):
                 only the chain's own meta text may ever grow a lane (frames never show
                 add-frame/lock icons), so without the ".chain" class this rule would widen a
                 frame's own meta text on hover of that same frame, for no reason (see #1173). -->
            <Style Selector="TextBlock.meta">
                <Setter Property="Margin" Value="8,0,8,0" />
            </Style>
            <Style Selector="TextBlock.meta.locked">
                <Setter Property="Margin" Value="8,0,56,0" />
            </Style>
            <Style Selector="Grid.tree-row:pointerover TextBlock.meta.chain:not(.locked)">
                <Setter Property="Margin" Value="8,0,56,0" />
            </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="models:TreeNodeVm" ItemsSource="{Binding Children}">
                <!-- Background="Transparent" (not left null) so the whole row is hit-test-visible,
                     not just its child controls, since otherwise hovering empty space between the
                     header text and the meta text would fail to trigger Grid.tree-row:pointerover
                     above. -->
                <Grid Classes="tree-row" Background="Transparent" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                        <Panel Grid.Column="0">
                            <TextBlock Text="{Binding Header}"
                                       AutomationProperties.Name="{Binding Header}"
                                       Padding="4,2"
                                       Margin="0,0,4,0"
                                       IsVisible="{Binding !IsEditing}"
                                       DoubleTapped="OnHeaderDoubleTapped" />
                            <TextBox Text="{Binding EditingText, Mode=TwoWay}"
                                     IsVisible="{Binding IsEditing}"
                                     Padding="2,1"
                                     KeyDown="OnRenameKeyDown"
                                     LostFocus="OnRenameLostFocus" />
                        </Panel>
                        <!-- Frame count + total playtime (chain nodes) or frame length (frame
                             nodes), matching desktop's MainWindow tree (#623). Margin clears
                             whichever icon lane(s) are visible (see TextBlock.meta styles above,
                             #1035) so it never overlaps the add-frame/lock buttons. -->
                        <TextBlock Grid.Column="1"
                                   Classes="meta"
                                   Classes.locked="{Binding IsLocked}"
                                   Classes.chain="{Binding IsChainNode}"
                                   Text="{Binding Meta}"
                                   Foreground="{DynamicResource AccentCool}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding Meta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </Grid>
                    <Button Classes="add-frame-btn plus"
                            IsVisible="{Binding CanAddFrame}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="22" Height="22"
                            Padding="0"
                            Margin="0,0,4,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OnAddFrameBtnClick"
                            DoubleTapped="OnAddFrameBtnDoubleTapped" />
                    <Button Classes="lock-btn lock-icon"
                            Classes.locked="{Binding IsLocked}"
                            IsVisible="{Binding IsChainNode}"
                            AutomationProperties.AutomationId="chain-lock-btn"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="22" Height="22"
                            Padding="0"
                            Margin="0,0,30,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OnLockBtnClick" />
                </Grid>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>
