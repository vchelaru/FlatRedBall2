<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AnimationEditor.Views.Controls.EditorNotificationOverlay"
             IsHitTestVisible="False">
    <!--
        Phase 15: item-deleted undo toast, generic status toast, and error banner lifted from
        desktop MainWindow.axaml overlays so the browser build can host them without duplicating
        timer/dismiss logic. IsHitTestVisible=False on the root so hidden overlays never block
        the editor; each visible panel re-enables hit-testing on itself.
    -->
    <Panel>
        <Border x:Name="ItemDeletedToastPanel" x:FieldModifier="Public"
                IsVisible="False"
                IsHitTestVisible="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,30"
                Background="#333"
                CornerRadius="4"
                Padding="12,6"
                ZIndex="50">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="ItemDeletedToastLabel" x:FieldModifier="Public"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="12" />
                <Button x:Name="ItemDeletedToastUndoBtn" x:FieldModifier="Public"
                        Content="Undo"
                        Padding="8,3"
                        FontSize="12" />
            </StackPanel>
        </Border>

        <Border x:Name="ErrorBanner" x:FieldModifier="Public"
                IsVisible="False"
                IsHitTestVisible="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                MaxWidth="640"
                Background="#2D2122"
                BorderBrush="#E0533F"
                BorderThickness="1.5"
                CornerRadius="6"
                Padding="14,10"
                ZIndex="60">
            <DockPanel>
                <Button x:Name="ErrorBannerDismissBtn" x:FieldModifier="Public"
                        DockPanel.Dock="Right"
                        Content="✕"
                        Width="24" Height="22"
                        Margin="10,0,0,0"
                        Padding="0" BorderThickness="0"
                        Background="Transparent"
                        Foreground="#E8B0A8"
                        VerticalAlignment="Top" />
                <TextBlock DockPanel.Dock="Left"
                           Text="⚠"
                           FontSize="15"
                           Foreground="#F2A03E"
                           Margin="0,0,10,0"
                           VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorBannerText" x:FieldModifier="Public"
                           FontSize="12"
                           Foreground="#F5E2DF"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- #1130: floating top-right card instead of a bottom chrome-colored bar, so a
             confirmation reads like a phone/desktop notification instead of blending into the
             window rail. ZIndex above ErrorBanner (60) since this is the most frequent overlay
             and must never end up hidden behind it; top-right (not ErrorBanner's top-center)
             so the two never occupy the same screen region if both are visible at once.
             InfoBannerBg + AccentCool left stripe reuses MainWindow's existing "tier-2
             actionable info" styling (see DefaultHandlerBanner) instead of inventing a new
             color language, while staying distinct from ErrorBanner's red and
             ItemDeletedToastPanel's plain #333. -->
        <Border x:Name="ToastPanel" x:FieldModifier="Public"
                IsVisible="False"
                IsHitTestVisible="True"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,16,0"
                MaxWidth="420"
                Background="{DynamicResource InfoBannerBg}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="6"
                BoxShadow="0 4 16 0 #4D000000"
                ZIndex="70">
            <DockPanel>
                <Border DockPanel.Dock="Left"
                        Width="3"
                        Background="{DynamicResource AccentCool}" />
                <DockPanel Margin="10,8">
                    <Button x:Name="ToastDismissBtn" x:FieldModifier="Public"
                            DockPanel.Dock="Right"
                            Content="✕"
                            Width="28" Height="22"
                            Padding="0" BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource InkMid}"
                            VerticalAlignment="Top" />
                    <Button x:Name="ToastRetryBtn" x:FieldModifier="Public"
                            DockPanel.Dock="Right"
                            Content="Retry"
                            Height="22"
                            Padding="8,0"
                            Margin="0,0,4,0"
                            VerticalAlignment="Top" />
                    <TextBlock x:Name="ToastMessage" x:FieldModifier="Public"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Ink}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
