<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AnimationEditor.Views.Controls.SearchToggleBox"
             x:Name="Root">
    <!--
        Icon-toggled inline search box shared by the ANIMATIONS tree, the Project tab, and the
        Images tab. The magnifier toggles a box with a two-stage clear; what a query means
        (sticky vs. clear-on-select) is up to each caller.
    -->
    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" x:FieldModifier="Public"
                 Width="140" Height="24"
                 Padding="6,2"
                 FontSize="11"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 IsVisible="False"
                 PlaceholderText="{Binding #Root.Placeholder}">
            <TextBox.InnerRightContent>
                <Button x:Name="SearchClearBtn" x:FieldModifier="Public"
                        Width="20" Height="20"
                        Padding="0"
                        Margin="0,0,2,0"
                        Focusable="False"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource IconInkDim}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Clear filter (empties, then closes)">
                    <TextBlock Text="&#x2715;" FontSize="10" />
                </Button>
            </TextBox.InnerRightContent>
        </TextBox>
        <Button x:Name="SearchToggleBtn" x:FieldModifier="Public"
                Width="24" Height="24"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{DynamicResource IconInkDim}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Search">
            <TextBlock Text="&#x1F50D;" FontSize="11" />
        </Button>
    </StackPanel>
</UserControl>
