<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The UI controls (WireframeControl, PreviewControl, and their support types) have no
    dependency on Avalonia.Desktop, so they live in this library and are tested headlessly by
    AnimationEditor.Views.Tests.

    Namespaces are left unchanged (AnimationEditor.App.Controls/.Theming/.Services) so no
    existing call site, XAML reference, or test needs to change, same approach as the
    AnimationChain.Common split.
  -->
  <PropertyGroup>
    <AnimationEditorTargetFramework Condition="'$(AnimationEditorTargetFramework)' == ''">net10.0</AnimationEditorTargetFramework>
    <TargetFramework>$(AnimationEditorTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnimationEditor.Core\AnimationEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="SkiaSharp" />
    <!-- Phase 7 (#644): shared SVG toolbar/spinner icons; see ThemeIconResources.axaml. -->
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only .axaml files with x:Class (UserControls) are picked up by the SDK's default
         AvaloniaResource glob; a bare ResourceDictionary with no x:Class needs an explicit item
         (confirmed by a failing AvaloniaXamlLoader.Load: "No precompiled XAML found... make sure
         to specify x:Class and include your XAML file as AvaloniaResource"). -->
    <AvaloniaResource Include="Theming\ThemeTokens.axaml" />
    <AvaloniaResource Include="Theming\ThemeStyles.axaml" />
    <AvaloniaResource Include="Theming\ThemeIconResources.axaml" />
    <AvaloniaResource Include="Assets\icons\svg\**" />
    <!-- Tiled logo, reused for a .tsx row in ProjectPanelControl's tree; a copy of
         AnimationEditor.App's own Assets\icons\tiled-icon-128.png, since Views can't load
         App's resources. -->
    <AvaloniaResource Include="Assets\icons\png\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- AnimationEditor.App itself needs this now too, not just its test project: several
         members these controls expose to MainWindow (PreviewControl.HGuides/VGuides/SetGuides,
         CanvasPalette, etc.) are internal, and internal access does not cross assembly
         boundaries just because it used to be the same file/assembly before this split.
         Target "AnimationEditor", not "AnimationEditor.App": AnimationEditor.App.csproj
         overrides <AssemblyName> to "AnimationEditor" (for the macOS Dock label; see that
         csproj), so that is the real assembly name InternalsVisibleTo must match. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AnimationEditor</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AnimationEditor.App.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AnimationEditor.Views.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
