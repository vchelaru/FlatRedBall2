<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AnimationEditorTargetFramework Condition="'$(AnimationEditorTargetFramework)' == ''">net10.0</AnimationEditorTargetFramework>
    <TargetFramework>$(AnimationEditorTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>aecli</AssemblyName>
    <RootNamespace>AnimationEditor.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Command-line front end for the editing operations. References only Editing: no Avalonia or SkiaSharp. -->
  <ItemGroup>
    <ProjectReference Include="..\AnimationEditor.Editing\AnimationEditor.Editing.csproj" />
  </ItemGroup>

</Project>
