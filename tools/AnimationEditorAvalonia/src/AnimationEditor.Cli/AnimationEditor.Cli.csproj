<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AnimationEditorTargetFramework Condition="'$(AnimationEditorTargetFramework)' == ''">net10.0</AnimationEditorTargetFramework>
    <TargetFramework>$(AnimationEditorTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>aecli</AssemblyName>
    <RootNamespace>AnimationEditor.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Build time for the aecli version flag. The source commit is already in the informational version (+<sha>) that the SDK embeds. -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss'))Z" />
  </ItemGroup>

  <!-- Command-line front end for the editing operations. References Editing, and Views for the render command (SkiaSharp drawing; Avalonia assemblies ride along, no window is ever created). -->
  <ItemGroup>
    <ProjectReference Include="..\AnimationEditor.Editing\AnimationEditor.Editing.csproj" />
    <ProjectReference Include="..\AnimationEditor.Views\AnimationEditor.Views.csproj" />
  </ItemGroup>

</Project>
