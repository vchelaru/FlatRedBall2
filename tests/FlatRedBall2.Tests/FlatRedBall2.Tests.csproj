<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!--
      Not set here, though it would be valuable: JsonSerializerIsReflectionEnabledByDefault=false
      makes reflection-based System.Text.Json throw, so a test cannot pass while the code it covers
      would fail once published AOT. It is assembly-wide, and AutomationMode deliberately uses
      reflection-based serialization (see the IL2026/IL3050 suppressions in src/Automation/
      AutomationMode.cs), so turning it on fails ~12 automation tests that are working as intended.
      Enforcing it would mean giving AutomationMode its own serializer context first.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AsepriteDotNet" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MonoGame.Framework.DesktopGL">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FlatRedBall2.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Animation\Content\Corpus\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Animation\Content\Snapshot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Glue\Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
