<Project>
  <!--
    NuGet Central Package Management (CPM) for the main build graph: src/**, tests/**,
    samples/**, diagnostics/**. Every PackageReference under those directories must omit its
    Version attribute — the version lives here, in exactly one place, so sibling projects
    (e.g. a sample's Common project and its Desktop head) can never resolve different exact
    versions of the same package and hit a runtime FileNotFoundException (#776).

    templates/frb2-desktop, templates/frb2-multiplatform, and tools/AnimationEditorAvalonia
    each ship their OWN Directory.Packages.props and are NOT managed by this file — the
    templates must be self-contained (they get scaffolded into a brand-new standalone repo),
    and AnimationEditorAvalonia is an unrelated dependency graph (Avalonia/SkiaSharp).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Several packages below are still pinned with a floating range (e.g. 4.*, 2.9.*) —
         CPM blocks floating PackageVersion entries by default. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- NU1507 recommends NuGet package source mapping whenever CPM is combined with more
         than one configured package source (nuget.org + the private feed here). Adding source
         mapping is a separate, bigger change; suppress the advisory instead. -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <!--
    Apos.Shapes ships only buildTransitive assets and embeds its shader directly in the
    assembly as of 0.7.2 — no MonoGame content pipeline, no Wine dependency. Both backend
    packages are pinned to the same version here since they track the same upstream release.
  -->
  <PropertyGroup>
    <!-- 0.7.8 shipped ~10 hours before ShadowDusk fixed a trunc() lowering bug in its GLSL
         rewriter (Apos.Shapes #34) that crashed any shape draw on macOS DesktopGL — see
         AposShapesEmbeddedShaderPortabilityTests and issue #853. Keep at or above the first
         fixed release (0.7.9). -->
    <AposShapesVersion>0.8.1</AposShapesVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AsepriteDotNet" Version="1.9.1" />
    <PackageVersion Include="FlatRedBall.InterpolationCore" Version="2025.4.22.1" />
    <PackageVersion Include="NVorbis" Version="0.10.5" />
    <PackageVersion Include="Apos.Shapes" Version="$(AposShapesVersion)" />
    <PackageVersion Include="Apos.Shapes.KNI" Version="$(AposShapesVersion)" />
    <PackageVersion Include="Gum.MonoGame" Version="2026.8.28.2-preview.1" />
    <PackageVersion Include="Gum.Shapes.MonoGame" Version="2026.8.28.2-preview.1" />
    <PackageVersion Include="Gum.KNI" Version="2026.8.28.2-preview.1" />
    <PackageVersion Include="Gum.Shapes.KNI" Version="2026.8.28.2-preview.1" />
    <!-- KernSmith moved from a 0.x scheme to the same date-based versioning as Gum, tracking
         Gum's release cadence 1:1. 0.16.0 was its last 0.x release, so a floating "0.16.*" no
         longer matches anything published; pin exactly like the Gum.* packages above.
         2026.8.28.2-preview.1 carries the fix for issue #1000/#1003's BlazorGL font-oversampling
         crash (TextRuntime.RegenerateOversampledFont now catches InMemoryFontCreator failures
         instead of leaving GumBatch's Begin()/End() unbalanced). -->
    <PackageVersion Include="KernSmith.MonoGameGum" Version="2026.8.28.2-preview.1" />
    <PackageVersion Include="KernSmith.KniGum" Version="2026.8.28.2-preview.1" />
    <!-- Rasterizer backend package, pinned to the same version as the core KernSmith package
         KernSmith.KniGum depends on transitively (2026.8.28.1-preview.1 -> KernSmith 0.20.0). -->
    <PackageVersion Include="KernSmith.Rasterizers.StbTrueType" Version="0.20.0" />
    <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageVersion Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
    <PackageVersion Include="MonoGame.Extended" Version="6.0.0" />
    <PackageVersion Include="KNI.Extended" Version="6.0.0" />
    <PackageVersion Include="nkast.Xna.Framework" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Content" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Graphics" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Audio" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Media" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Input" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Game" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Devices" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Storage" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.XR" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="4.3.9001" />
    <PackageVersion Include="nkast.Kni.Platform.Blazor.GL" Version="4.3.9001" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.*" />
    <PackageVersion Include="Shouldly" Version="4.*" />
    <PackageVersion Include="xunit" Version="2.9.*" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.*" />
  </ItemGroup>
</Project>
