<Project>
  <!--
    Self-contained CPM file for this template — do NOT reference the repo root's
    Directory.Packages.props or templates/frb2-desktop's. `dotnet new` scaffolds this
    template's content/ folder into a brand-new standalone repo, so every version this
    template needs must live here.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- FlatRedBall2.Kni / FlatRedBall2.MonoGame are pinned to "*-*" (any prerelease) — CPM
         blocks floating PackageVersion entries by default. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- NU1507 recommends NuGet package source mapping whenever CPM is combined with more
         than one configured package source. Suppress the advisory rather than take on
         source mapping here. -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FlatRedBall2.Kni" Version="*-*" />
    <PackageVersion Include="FlatRedBall2.MonoGame" Version="*-*" />
    <!-- Kept at 3.8.4.1, NOT bumped to match root — the committed apos-shapes.xnb precompiled
         shader (see build/AposShapesPrecompiled.props) was compiled by this exact MGCB toolchain
         version and PrecompiledShaderCompatibilityTests.cs pins it. Bumping requires regenerating
         that xnb (build a DesktopGL sample with the new MGCB, recopy the output) and updating the
         test's ExpectedMonoGameVersion in lockstep — do that as part of design/TODOS.md's "Remove
         templates' precompiled Apos.Shapes shader workaround" item, not as a side effect here. -->
    <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageVersion Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
    <PackageVersion Include="nkast.Xna.Framework" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Content" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Graphics" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Audio" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Media" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Input" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Game" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Devices" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Storage" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.XR" Version="4.3.9001" />
    <PackageVersion Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="4.3.9001" />
    <PackageVersion Include="nkast.Kni.Platform.Blazor.GL" Version="4.3.9001" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" />
  </ItemGroup>
</Project>
