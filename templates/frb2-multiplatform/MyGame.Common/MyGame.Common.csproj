<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      MonoGame/desktop backend build of Common. MyGame.Common.Kni.csproj (same directory) is
      the KNI/browser sibling — two sibling single-TFM files rather than one project
      multi-targeting net8.0/net10.0, since both backends now target net10.0 and a single
      project can't list the same TFM twice to pick different package sets. See the
      multiplatform-conversion skill for the full rationale.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyGame</RootNamespace>
    <DefineConstants>$(DefineConstants);MONOGAME</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlatRedBall2.MonoGame" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>
</Project>
