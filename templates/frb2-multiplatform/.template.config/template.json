{
  "$schema": "http://json.schemastore.org/template",
  "author": "FlatRedBall2",
  "classifications": ["Games", "MonoGame", "KNI", "Blazor", "FlatRedBall2"],
  "identity": "FlatRedBall2.Templates.Multiplatform",
  "name": "FlatRedBall2 Multiplatform Game (Desktop + Web)",
  "shortName": "frb2-multiplatform",
  "sourceName": "MyGame",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "IncludeStarterContent": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include starter Content assets (animation chains, base TMX, platformer/topdown configs). Pass --IncludeStarterContent false to start with an empty Content folder."
    },
    "namespace": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": false,
      "description": "Root namespace for generated C# code (the <RootNamespace> in each .csproj). Defaults to the project name (-n) — pass this to keep the folder/project name and the root namespace independent, e.g. --namespace Amazing."
    },
    "namespaceReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "namespace",
        "fallbackVariableName": "name"
      },
      "replaces": "GameNamespace"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!IncludeStarterContent)",
          "exclude": [ "MyGame.Common/Content/*/**" ]
        }
      ]
    }
  ],
  "SpecialCustomOperations": {
    "**/*.cs": {
      "Operations": [
        {
          "Type": "conditional",
          "Configuration": {
            "if": [ "//#if" ],
            "else": [ "//#else" ],
            "elseif": [ "//#elseif" ],
            "endif": [ "//#endif" ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    }
  }
}
