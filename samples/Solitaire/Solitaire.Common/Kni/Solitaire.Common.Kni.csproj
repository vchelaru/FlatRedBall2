<Project Sdk="Microsoft.NET.Sdk">
  <!--
    KNI/browser backend build of Common — see ..\Solitaire.Common.csproj for the
    MonoGame/desktop sibling. This file lives in its own Kni\ subfolder rather than next to it —
    see the comment atop src/Kni/FlatRedBall2.Kni.csproj for why two SDK projects can't share one
    physical directory here (a real MSBuild parallel-build race, #966).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Solitaire</RootNamespace>
    <DefineConstants>$(DefineConstants);KNI</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\**\*.cs" Exclude="..\obj\**;..\bin\**;..\Kni\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" />
    <PackageReference Include="nkast.Xna.Framework.Game" />
    <PackageReference Include="nkast.Xna.Framework.Input" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Kni\FlatRedBall2.Kni.csproj" />
  </ItemGroup>

  <!--
    Gum content deployment. See ..\..\Solitaire.GumPackage.targets for the
    UseGumPackage toggle that flips between loose files and a packed .gumpkg.
  -->
  <Import Project="..\..\Solitaire.GumPackage.targets" />

  <!-- Loose mode (default): copy every Gum source file. Link preserves the same
       Content\GumProject\... output-relative path the MonoGame sibling uses, since the source
       now lives outside this project's own directory (..\Content\...). -->
  <ItemGroup Condition="'$(UseGumPackage)' != 'true'">
    <Content Include="..\Content\GumProject\**\*.*"
             Exclude="..\Content\GumProject\**\*.gumpkg"
             Link="Content\GumProject\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <None Remove="..\Content\GumProject\**\*.*" />
  </ItemGroup>

  <!-- Bundle mode: copy ONLY the .gumpkg. The runtime sees no .gumj and switches to bundle load. -->
  <ItemGroup Condition="'$(UseGumPackage)' == 'true'">
    <Content Include="..\Content\GumProject\GumProject.gumpkg"
             Link="Content\GumProject\GumProject.gumpkg"
             CopyToOutputDirectory="PreserveNewest" />
    <None Remove="..\Content\GumProject\**\*.*" />
  </ItemGroup>
</Project>
