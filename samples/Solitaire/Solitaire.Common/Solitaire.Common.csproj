<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Solitaire</RootNamespace>
    <DefineConstants>$(DefineConstants);MONOGAME</DefineConstants>
    <!-- Kni\Solitaire.Common.Kni.csproj compiles this directory's source explicitly rather
         than sharing this project's own default glob — see the comment atop
         src/Kni/FlatRedBall2.Kni.csproj for why they can't share a folder. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Kni\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    MonoGame/desktop backend build of Common. Kni\Solitaire.Common.Kni.csproj is the
    KNI/browser sibling — see src/FlatRedBall2.csproj for why these are two sibling single-TFM
    files instead of one multi-targeted project.
  -->
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FlatRedBall2.csproj" />
  </ItemGroup>

  <!--
    Gum content deployment. See ../Solitaire.GumPackage.targets for the
    UseGumPackage toggle that flips between loose files and a packed .gumpkg.
  -->
  <Import Project="..\Solitaire.GumPackage.targets" />

  <!-- Loose mode (default): copy every Gum source file. -->
  <ItemGroup Condition="'$(UseGumPackage)' != 'true'">
    <Content Include="Content\GumProject\**\*.*"
             Exclude="Content\GumProject\**\*.gumpkg"
             CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Content\GumProject\**\*.*" />
  </ItemGroup>

  <!-- Bundle mode: copy ONLY the .gumpkg. The runtime sees no .gumj and switches to bundle load. -->
  <ItemGroup Condition="'$(UseGumPackage)' == 'true'">
    <Content Include="Content\GumProject\GumProject.gumpkg"
             CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Content\GumProject\**\*.*" />
  </ItemGroup>
</Project>
